{
    "name": "mbn-theme",
    "version": "1.2.0",
    "private": true,
    "scripts": {
        "build": "npm run build:css && npm run build:blocks",
        "build:css": "node node_modules/tailwindcss/lib/cli.js -i ./resources/css/app.css -o ./assets/build/tailwind.css --minify",
        "bundle": "npm run build && node scripts/bundle.mjs",
        "build:blocks": "node node_modules/webpack/bin/webpack.js --config webpack.config.js --mode production && npm run copy:assets",
        "start": "npm-run-all --parallel watch:*",
        "watch:css": "node node_modules/tailwindcss/lib/cli.js -i ./resources/css/app.css -o ./assets/build/tailwind.css --watch --poll",
        "watch:blocks": "npm run copy:assets && node node_modules/webpack/bin/webpack.js --config webpack.config.js --mode development --watch",
        "watch:browser": "node node_modules/browser-sync/dist/bin.js start --config bs-config.js",
        "dev": "npm-run-all --parallel watch:css watch:blocks",
        "lint:php": "composer run lint",
        "lint:php:fix": "composer run lint:fix",
        "copy:assets": "node scripts/copy-block-assets.mjs"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@wordpress/block-editor": "^12.15.0",
        "@wordpress/blocks": "^12.24.0",
        "@wordpress/components": "^25.13.0",
        "@wordpress/element": "^5.24.0",
        "@wordpress/i18n": "^4.47.0",
        "@wordpress/icons": "^9.38.0",
        "composer": "^4.1.0"
    },
    "devDependencies": {
        "@wordpress/scripts": "^32.2.0",
        "autoprefixer": "^10.4.20",
        "browser-sync": "^3.0.2",
        "copy-webpack-plugin": "^14.0.0",
        "glob": "^13.0.6",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.49",
        "postcss-import": "^16.1.0",
        "tailwindcss": "^3.4.17"
    }
}
