		<taxonomy translate="1">case_result_category</taxonomy>
	</taxonomies>

	<custom-fields>
		<!-- 2 = translate, 1 = copy from original, 0 = ignore -->
		<custom-field action="translate">_case_result_case_title</custom-field>
		<custom-field action="translate">_case_result_description</custom-field>
		<custom-field action="translate">_case_result_amount</custom-field>
		<custom-field action="translate">_practice_area_sidebar_title</custom-field>
		<custom-field action="translate">_mbn_testimonial_role</custom-field>

		<custom-field action="copy">_mbn_testimonial_rating</custom-field>
		<custom-field action="copy">_mbn_review_image_ids</custom-field>
		<custom-field action="copy">_theme_asset_file</custom-field>
		<custom-field action="copy">_wp_page_template</custom-field>

		<!-- Raw HTML injection per post: copy, never machine-translate. -->
		<custom-field action="copy">_blgf_post_html_head</custom-field>
		<custom-field action="copy">_blgf_post_html_before_body</custom-field>
		<custom-field action="copy">_blgf_post_html_after_body</custom-field>
		<custom-field action="copy">_blgf_post_html_footer</custom-field>
	</custom-fields>

</wpml-config>
