	<custom-types>
		<!-- 1 = translatable. These were never registered with WPML, which is why
		     the imported Spanish attorneys / practice areas are orphaned. -->
		<custom-type translate="1">attorney</custom-type>
		<!-- practice_area: translatable (translate="1"). This was set to "0" for a
		     while to fix a 404 bug: marking it translatable makes WPML inner-join
		     every practice_area query against icl_translations by current language,
		     and 97 of 108 posts had never been registered with a language, so the
		     inner join dropped them - every one 404'd despite existing and having
		     content. Turning translation back off worked, but it also silently
		     broke AI-translated content from ever appearing on the live page,
		     since WPML's Gutenberg render-time string swap is gated on the post
		     type being translatable - the string can be registered and "published"
		     with translate="0" and still never actually display.
		     THE REAL FIX (not a workaround): scripts/wpml-assign-language-to-orphans.php
		     backfills a language record for all 97 previously-untracked posts. With
		     every post correctly tagged, the inner join that caused the original 404
		     now matches everything, so re-enabling this is safe. Do not flip this
		     back to "0" without also reverting that backfill, or the 404 returns.
		     language record. -->
		<custom-type translate="1">practice_area</custom-type>
		<custom-type translate="1">case_result</custom-type>
		<custom-type translate="1">mbn_review_month</custom-type>
		<custom-type translate="1">mbn_testimonial</custom-type>
		<!-- Header/Footer block templates carry translatable copy (tagline,
		     copyright, button labels). NOTE: this post type is also written by the
		     theme's template sync tools - an "Import from Files" will overwrite
		     translated templates. Coordinate the two before using sync in production. -->
		<custom-type translate="1">mbn_block_template</custom-type>
	</custom-types>

